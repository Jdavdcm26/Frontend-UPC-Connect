# Dirección de la API. Vacío = mismo dominio que la web (staging y producción).
VITE_API_URL=
# Simula la sesión sin backend (solo desarrollo). Con la API real debe ser false.
VITE_USAR_FIXTURES=false
# Clave pública de Cloudflare Turnstile (verificación de seguridad).
# Esta es la clave de prueba de Cloudflare: siempre aprueba. En producción va la clave real.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
